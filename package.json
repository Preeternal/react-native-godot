{
  "name": "@preeternal/react-native-godot",
  "version": "0.1.0",
  "description": "Embed Godot into React Native apps",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native": "./src/index.tsx",
      "preeternal-react-native-godot-source": "./src/index.tsx",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "cpp",
    "android",
    "ios",
    "scripts",
    "app.plugin.js",
    "react-native-godot.podspec",
    "Package.swift",
    "prebuilt-utils.rb",
    "react-native.config.js",
    "!lib/typescript/example",
    "!ios/libs",
    "!ios/build",
    "!android/libs",
    "!android/build",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "example": "yarn workspace @preeternal/react-native-godot-example",
    "android": "yarn workspace @preeternal/react-native-godot-example android",
    "ios": "yarn workspace @preeternal/react-native-godot-example ios",
    "start": "yarn workspace @preeternal/react-native-godot-example start",
    "clean": "del-cli android/build example/android/build example/android/app/build example/ios/build lib",
    "prepare": "bob build",
    "postinstall": "node scripts/download-prebuilt.js",
    "download-prebuilt": "node scripts/download-prebuilt.js",
    "check:packaged-artifacts": "bash scripts/check-packaged-artifacts.sh",
    "typecheck": "tsc",
    "test": "node --test scripts/__tests__/*.test.cjs && jest --passWithNoTests",
    "release": "release-it --only-version",
    "lint": "eslint \"**/*.{js,cjs,mjs,ts,tsx}\""
  },
  "keywords": [
    "react-native",
    "ios",
    "android"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Preeternal/react-native-godot.git"
  },
  "author": "Preeternal <preeternal@gmail.com> (https://github.com/Preeternal)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/Preeternal/react-native-godot/issues"
  },
  "homepage": "https://github.com/Preeternal/react-native-godot#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "npm": {
    "versionArgs": [
      "--allow-same-version",
      "--workspaces-update=false"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@jest/globals": "^29.7.0",
    "@react-native/babel-preset": "0.88.0",
    "@react-native/eslint-config": "0.88.0",
    "@react-native/jest-preset": "0.88.0",
    "@release-it/conventional-changelog": "^12.0.2",
    "@types/react": "^19.2.0",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^29.7.0",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.0",
    "react-native-builder-bob": "^0.44.1",
    "react-native-worklets": "patch:react-native-worklets@npm%3A0.13.1#~/.yarn/patches/react-native-worklets-npm-0.13.1-3a63e554a7.patch",
    "release-it": "^21.1.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "react": "*",
    "react-native": "*",
    "react-native-worklets": ">=0.13.0 <0.14.0"
  },
  "codegenConfig": {
    "name": "RTNGodotSpec",
    "type": "all",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.preeternal.reactnativegodot"
    },
    "ios": {
      "modulesProvider": {
        "NativeGodotModule": "NativeGodotModuleProvider"
      },
      "components": {
        "RTNGodotView": {
          "className": "RTNGodotView"
        }
      }
    }
  },
  "jest": {
    "preset": "@react-native/jest-preset",
    "testEnvironmentOptions": {
      "customExportConditions": [
        "require",
        "react-native",
        "preeternal-react-native-godot-source"
      ]
    },
    "transformIgnorePatterns": [
      "node_modules/(?!((jest-)?react-native|@react-native(-community)?|@react-navigation/.*|react-native-worklets)/)"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "prebuiltFiles": [
    {
      "name": "libgodot",
      "filename": "libgodot.xcframework.zip",
      "version": "4.7.2.preeternal.1",
      "base_url": "https://github.com/Preeternal/libgodot/releases/download/",
      "shasum": "6bbf51634153ad9206352e36d069cbdf4e8a2a63e11e828a73b38e9a6adc5de5",
      "destination_base_dir": "ios/libs",
      "env": "LIBGODOT_XCFRAMEWORK_PATH",
      "no_unpack": "false"
    },
    {
      "name": "libgodot-cpp",
      "filename": "libgodot-cpp.xcframework.zip",
      "version": "4.7.2.preeternal.1",
      "base_url": "https://github.com/Preeternal/libgodot/releases/download/",
      "shasum": "a6a7f0737c9cd5eb981098fe253f794df27aafd14835f6889da3536de92d550e",
      "destination_base_dir": "ios/libs",
      "env": "LIBGODOT_CPP_XCFRAMEWORK_PATH",
      "no_unpack": "false"
    },
    {
      "name": "libgodot-android",
      "filename": "libgodot-android.zip",
      "version": "4.7.2.preeternal.1",
      "base_url": "https://github.com/Preeternal/libgodot/releases/download/",
      "shasum": "e5b94be7fe7f74ce2f147f90ccb2c28a972a91638734d6518807593c15d2c7db",
      "destination_base_dir": "android/libs",
      "env": "LIBGODOT_ANDROID_PATH",
      "no_unpack": "false",
      "maven_version": "4.7.2.preeternal.1-SNAPSHOT"
    },
    {
      "name": "libgodot-cpp-android",
      "filename": "godot-cpp-android.zip",
      "version": "4.7.2.preeternal.1",
      "base_url": "https://github.com/Preeternal/libgodot/releases/download/",
      "shasum": "90966d0add089ebffe3baa3f4ea918d329e22fbc0b1a3c267d3c7ef7476f41cc",
      "destination_base_dir": "android/libs",
      "env": "LIBGODOT_CPP_ANDROID_PATH",
      "no_unpack": "false"
    }
  ],
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "workspaces": [
    "example"
  ],
  "engines": {
    "node": "^20.19.4 || ^22.13.0 || ^24.3.0 || >=25.0.0"
  },
  "packageManager": "yarn@4.18.1+sha512.b2e1e7524f654f2749d32b4ebcb4622473cb5bcbc485df2007e12a154e50162a4d795526768bc5f5b8f81717bfd79deb2472813d86fb5ae2eb551fa9c872b08f",
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "dependenciesMeta": {
    "lefthook": {
      "built": true
    }
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "v${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "tools": [
      "jest",
      "lefthook",
      "release-it",
      "eslint"
    ],
    "version": "0.64.0"
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  }
}
